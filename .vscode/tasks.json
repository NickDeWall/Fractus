{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Fractus (Static)",
            "type": "shell",
            "command": "g++.exe",
            "args": [
                "-DGLEW_STATIC",
                "-s",
                "-static",
                "-o",
                "${workspaceFolder}\\build\\release\\Fractus.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\core\\app.cpp",
                "${workspaceFolder}\\src\\core\\window.cpp",
                "${workspaceFolder}\\src\\input\\input_manager.cpp",
                "${workspaceFolder}\\src\\render\\collision_field.cpp",
                "${workspaceFolder}\\src\\render\\fractal_manager.cpp",
                "${workspaceFolder}\\src\\render\\display_modes.cpp",
                "${workspaceFolder}\\src\\render\\overlay_renderer.cpp",
                "${workspaceFolder}\\src\\render\\shader_manager.cpp",
                "${workspaceFolder}\\src\\scene\\screen.cpp",
                "${workspaceFolder}\\src\\scene\\screen_manager.cpp",
                "${workspaceFolder}\\src\\ui\\ui_manager.cpp",
                "${workspaceFolder}\\src\\util\\math_utils.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_draw.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_tables.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_widgets.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_impl_sdl2.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_impl_opengl3.cpp",
                "-I${workspaceFolder}\\src",
                "-I${workspaceFolder}\\third_party\\imgui",
                "-IC:\\msys64\\mingw64\\include\\SDL2",
                "-LC:\\msys64\\mingw64\\lib",
                "-lSDL2main",
                "-lSDL2",
                "-lSDL2_ttf",
                "-lfreetype",
                "-lharfbuzz",
                "-lgraphite2",
                "-lbrotlidec",
                "-lbrotlienc",
                "-lbrotlicommon",
                "-lrpcrt4",
                "-ldwrite",
                "-lpng",
                "-lz",
                "-lbz2",
                "-lglew32",
                "-lopengl32",
                "-lwinpthread",
                "-lgdi32",
                "-luser32",
                "-lkernel32",
                "-lwinmm",
                "-lversion",
                "-limm32",
                "-lsetupapi",
                "-lole32",
                "-loleaut32",
                "-static-libgcc",
                "-static-libstdc++",
                "-mwindows",
                "-O3"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build Fractus (Dynamic)",
            "type": "shell",
            "command": "g++.exe",
            "args": [
                "-g",
                "-o",
                "${workspaceFolder}\\build\\debug\\Fractus.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\core\\app.cpp",
                "${workspaceFolder}\\src\\core\\window.cpp",
                "${workspaceFolder}\\src\\input\\input_manager.cpp",
                "${workspaceFolder}\\src\\render\\collision_field.cpp",
                "${workspaceFolder}\\src\\render\\fractal_manager.cpp",
                "${workspaceFolder}\\src\\render\\display_modes.cpp",
                "${workspaceFolder}\\src\\render\\overlay_renderer.cpp",
                "${workspaceFolder}\\src\\render\\shader_manager.cpp",
                "${workspaceFolder}\\src\\scene\\screen.cpp",
                "${workspaceFolder}\\src\\scene\\screen_manager.cpp",
                "${workspaceFolder}\\src\\ui\\ui_manager.cpp",
                "${workspaceFolder}\\src\\util\\math_utils.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_draw.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_tables.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_widgets.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_impl_sdl2.cpp",
                "${workspaceFolder}\\third_party\\imgui\\imgui_impl_opengl3.cpp",
                "-I${workspaceFolder}\\src",
                "-I${workspaceFolder}\\third_party\\imgui",
                "-IC:\\msys64\\mingw64\\include\\SDL2",
                "-IC:\\msys64\\mingw64\\include",
                "-LC:\\msys64\\mingw64\\lib",
                "-lmingw32",
                "-lSDL2main",
                "-lSDL2",
                "-lSDL2_ttf",
                "-lglew32",
                "-lopengl32",
                "-limm32",
                "-mwindows",
                "-O3"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}